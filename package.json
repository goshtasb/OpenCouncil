{
  "name": "open-council",
  "version": "0.2.0",
  "description": "Three AIs argue over your spec until they agree. You approve it. Then one ships it as a tested, gated pull request. It never says done when it isn't.",
  "homepage": "https://github.com/goshtasb/OpenCouncil#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goshtasb/OpenCouncil.git"
  },
  "bugs": {
    "url": "https://github.com/goshtasb/OpenCouncil/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "council": "bin/council.js",
    "open-council": "bin/council.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc && mkdir -p dist/office/public && cp -r src/office/public/* dist/office/public/",
    "watch": "tsc -w",
    "start": "node bin/council.js",
    "test": "node --test test/*.test.cjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "agent-skills",
    "agents",
    "ai",
    "autonomous-coding",
    "claude",
    "claude-code",
    "claude-code-plugin",
    "code-review",
    "council",
    "deliberation",
    "engineering",
    "gemini",
    "grok",
    "multi-model",
    "prd",
    "pull-request",
    "verification"
  ],
  "author": "Ashkan Goshtasb (https://github.com/goshtasb)",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "execa": "^5.1.1",
    "js-yaml": "^4.1.0",
    "pdfkit": "^0.15.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ]
}
